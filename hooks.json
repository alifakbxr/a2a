{
  "a2a-session-telemetry": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./scripts/hook.mjs",
        "timeout": 5
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./scripts/hook.mjs",
        "timeout": 5
      }
    ],
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/hook.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
