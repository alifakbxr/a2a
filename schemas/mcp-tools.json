{
  "schema_version": "1.0.0",
  "tools": [
    {
      "name": "pilah_context",
      "description": "Scoped project symbols and file relations; static only.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workspace"
        ],
        "properties": {
          "workspace": {
            "type": "string",
            "maxLength": 1024
          },
          "action": {
            "type": "string",
            "enum": [
              "inspect",
              "query",
              "freshness",
              "tokens",
              "skeleton",
              "orchestration"
            ],
            "default": "inspect"
          },
          "query": {
            "type": "string",
            "maxLength": 160
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 40
          },
          "file": {
            "type": "string",
            "maxLength": 500
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 500
            },
            "maxItems": 20
          },
          "history_scope": {
            "type": "string",
            "enum": [
              "current",
              "all"
            ]
          },
          "history_limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "task": {
            "type": "object",
            "description": "Native advice only; launches nothing.",
            "additionalProperties": false,
            "properties": {
              "tier": {
                "type": "string",
                "enum": [
                  "free",
                  "pro",
                  "ultra",
                  "paid-other",
                  "unknown"
                ]
              },
              "available_commands": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "/swarm",
                    "/teamwork",
                    "/boost",
                    "@subagent"
                  ]
                },
                "maxItems": 4
              },
              "workstreams": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 120
                },
                "maxItems": 30
              },
              "dependencies": {
                "type": "string",
                "enum": [
                  "low",
                  "high",
                  "unknown"
                ]
              },
              "milestones": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "long_horizon": {
                "type": "boolean"
              },
              "hard_reasoning": {
                "type": "boolean"
              },
              "file_ownership": {
                "type": "string",
                "enum": [
                  "independent",
                  "shared",
                  "unknown"
                ]
              }
            }
          }
        }
      }
    },
    {
      "name": "pilah_impact",
      "description": "Static impact and candidate tests; not proof.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workspace"
        ],
        "properties": {
          "workspace": {
            "type": "string",
            "maxLength": 1024
          },
          "changed": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 500
            },
            "maxItems": 200
          },
          "depth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "summary": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "name": "pilah_verify",
      "description": "Local tests/evidence; not release proof.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workspace",
          "operation"
        ],
        "properties": {
          "workspace": {
            "type": "string",
            "maxLength": 1024
          },
          "operation": {
            "type": "string",
            "enum": [
              "plan",
              "assess",
              "verify_handoff",
              "assess_release",
              "assess_semantic",
              "assess_browser"
            ]
          },
          "changed": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 500
            },
            "maxItems": 200
          },
          "persist_plan": {
            "type": "boolean",
            "description": "Opt-in, revision-pinned plan."
          },
          "plan_id": {
            "type": "string",
            "maxLength": 120
          },
          "criteria": {
            "type": "array",
            "maxItems": 40,
            "items": {
              "oneOf": [
                {
                  "type": "string",
                  "maxLength": 240
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "maxLength": 160
                    },
                    "artifact": {
                      "type": "string",
                      "maxLength": 500
                    },
                    "test_name": {
                      "type": "string",
                      "maxLength": 160,
                      "description": "Exact test; * is legacy only."
                    },
                    "blocked": {
                      "type": "boolean"
                    },
                    "reason": {
                      "type": "string",
                      "maxLength": 240
                    },
                    "given": {
                      "type": "string",
                      "maxLength": 200
                    },
                    "when": {
                      "type": "string",
                      "maxLength": 200
                    },
                    "then": {
                      "type": "string",
                      "maxLength": 200
                    },
                    "evidence_type": {
                      "type": "string",
                      "enum": [
                        "build",
                        "unit",
                        "integration",
                        "browser",
                        "visual",
                        "hardware",
                        "security",
                        "independent"
                      ]
                    },
                    "viewport": {
                      "type": "string",
                      "maxLength": 160
                    },
                    "ui_state": {
                      "type": "string",
                      "maxLength": 160
                    },
                    "reference": {
                      "type": "string",
                      "maxLength": 160
                    },
                    "negative": {
                      "type": "boolean"
                    },
                    "source_revision": {
                      "type": "string",
                      "maxLength": 160
                    },
                    "description": {
                      "type": "string",
                      "maxLength": 160
                    }
                  }
                }
              ]
            }
          },
          "worker_name": {
            "type": "string",
            "maxLength": 128
          },
          "artifact": {
            "type": "string",
            "maxLength": 500
          },
          "allow_stale": {
            "type": "boolean",
            "description": "No-op: stale reports never pass."
          }
        }
      }
    },
    {
      "name": "pilah_evidence",
      "description": "Local incidents, RCA, history and artifacts.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workspace",
          "operation"
        ],
        "properties": {
          "workspace": {
            "type": "string",
            "maxLength": 1024
          },
          "operation": {
            "type": "string",
            "enum": [
              "list",
              "runs",
              "incidents",
              "record_incident",
              "add_hypothesis",
              "assess_hypothesis",
              "hypotheses",
              "delete_incident",
              "side_questions",
              "record_side_question",
              "artifact_versions",
              "artifact_diff",
              "snapshot_artifact",
              "save_checkpoint",
              "model_recovery",
              "tool_recovery"
            ]
          },
          "id": {
            "type": "string",
            "maxLength": 160
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "title": {
            "type": "string",
            "maxLength": 240
          },
          "root_cause": {
            "type": "string",
            "maxLength": 1400
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 500
            },
            "maxItems": 200
          },
          "criteria": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 240
            },
            "maxItems": 40
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 160
            },
            "maxItems": 20
          },
          "hypothesis": {
            "type": "string",
            "maxLength": 1000
          },
          "experiment": {
            "type": "string",
            "maxLength": 1000
          },
          "incident_id": {
            "type": "string",
            "maxLength": 160
          },
          "persist_rca": {
            "type": "boolean",
            "description": "Opt-in local private RCA retention."
          },
          "confirm_deletion": {
            "type": "boolean",
            "description": "Confirm logical removal; not secure erasure."
          },
          "hypothesis_id": {
            "type": "string",
            "maxLength": 128
          },
          "parent_hypothesis_id": {
            "type": "string",
            "maxLength": 128
          },
          "predicted_observation": {
            "type": "string",
            "maxLength": 300
          },
          "disconfirming_test": {
            "type": "string",
            "maxLength": 300
          },
          "expected_criterion_id": {
            "type": "string",
            "maxLength": 160,
            "description": "Named test only, not causal proof."
          },
          "plan_id": {
            "type": "string",
            "maxLength": 120
          },
          "experiment_outcome": {
            "type": "string",
            "enum": [
              "supports",
              "refutes",
              "inconclusive"
            ],
            "description": "Agent report; not independent proof."
          },
          "observation": {
            "type": "string",
            "maxLength": 400
          },
          "conversation_id": {
            "type": "string",
            "maxLength": 128
          },
          "parent_conversation_id": {
            "type": "string",
            "maxLength": 128
          },
          "question": {
            "type": "string",
            "maxLength": 4000
          },
          "summary": {
            "type": "string",
            "maxLength": 4000
          },
          "status": {
            "type": "string",
            "maxLength": 40
          },
          "task_summary": {
            "type": "string",
            "maxLength": 500
          },
          "completed": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "maxLength": 200
            }
          },
          "next_steps": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "maxLength": 200
            }
          },
          "artifact_name": {
            "type": "string",
            "maxLength": 240
          },
          "artifact_path": {
            "type": "string",
            "maxLength": 500
          },
          "v1": {
            "type": "integer",
            "minimum": 0
          },
          "v2": {
            "type": "integer",
            "minimum": 1
          },
          "decisions": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "maxLength": 200
            }
          },
          "pending_tests": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "maxLength": 200
            }
          },
          "tool_family": {
            "type": "string",
            "enum": [
              "mcp",
              "browser",
              "filesystem",
              "terminal",
              "other"
            ]
          },
          "error_hint": {
            "type": "string",
            "maxLength": 400
          },
          "error_class": {
            "type": "string",
            "enum": [
              "invalid_arguments",
              "context_lost",
              "timeout",
              "permission_denied",
              "missing_file",
              "edit_conflict",
              "unknown"
            ]
          },
          "retry_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20
          }
        }
      }
    }
  ]
}
