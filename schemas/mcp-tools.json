{
  "schema_version": "1.0.0",
  "tools": [
    {
      "name": "a2a_context",
      "description": "A2A project context and transparent conversation token history. History totals from internal logs are not provider-verified.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workspace"
        ],
        "properties": {
          "workspace": {
            "type": "string",
            "description": "Absolute path of an authorized workspace (Antigravity IDE workspaces authorized automatically)."
          },
          "action": {
            "type": "string",
            "enum": [
              "inspect",
              "query",
              "freshness",
              "tokens",
              "skeleton",
              "orchestration"
            ],
            "default": "inspect"
          },
          "query": {
            "type": "string",
            "maxLength": 160
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 40
          },
          "conversation_id": {
            "type": "string",
            "maxLength": 128,
            "description": "Optional Antigravity conversation ID for exact session token lookup."
          },
          "transcript_path": {
            "type": "string",
            "maxLength": 500,
            "description": "Optional path to transcript.jsonl for exact session token lookup."
          },
          "file": {
            "type": "string",
            "maxLength": 500,
            "description": "Relative file path for action=\"skeleton\"."
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 500
            },
            "maxItems": 20,
            "description": "Relative file paths for action=\"skeleton\"."
          },
          "history_scope": {
            "type": "string",
            "enum": [
              "current",
              "all"
            ],
            "description": "For tokens: current session by default; all explicitly reads local historical conversations."
          },
          "history_limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "description": "Maximum recent conversations returned for history."
          },
          "task": {
            "type": "object",
            "description": "For action=orchestration: user-declared available native commands, tier, workstreams, milestones; no workers launched.",
            "additionalProperties": false,
            "properties": {
              "tier": {
                "type": "string",
                "enum": [
                  "free",
                  "pro",
                  "ultra",
                  "paid-other",
                  "unknown"
                ]
              },
              "available_commands": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "/swarm",
                    "/teamwork",
                    "/boost",
                    "@subagent"
                  ]
                },
                "maxItems": 4
              },
              "workstreams": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 120
                },
                "maxItems": 30
              },
              "dependencies": {
                "type": "string",
                "enum": [
                  "low",
                  "high",
                  "unknown"
                ]
              },
              "milestones": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "long_horizon": {
                "type": "boolean"
              },
              "hard_reasoning": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    {
      "name": "a2a_impact",
      "description": "A2A static impact analysis, reverse dependencies, and affected token metrics.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workspace"
        ],
        "properties": {
          "workspace": {
            "type": "string",
            "description": "Absolute path of an authorized workspace (Antigravity IDE workspaces authorized automatically)."
          },
          "changed": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 500
            },
            "maxItems": 200
          },
          "depth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "summary": {
            "type": "boolean",
            "description": "Return a bounded risk/test triage summary while retaining uncertainty and full affected counts."
          }
        }
      }
    },
    {
      "name": "a2a_verify",
      "description": "A2A native test planning and JUnit/TAP/JSON evidence assessment.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workspace",
          "operation"
        ],
        "properties": {
          "workspace": {
            "type": "string",
            "description": "Absolute path of an authorized workspace (Antigravity IDE workspaces authorized automatically)."
          },
          "operation": {
            "type": "string",
            "enum": [
              "plan",
              "assess",
              "verify_handoff"
            ]
          },
          "changed": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 500
            },
            "maxItems": 200
          },
          "criteria": {
            "type": "array",
            "maxItems": 40,
            "items": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "maxLength": 160
                    },
                    "artifact": {
                      "type": "string",
                      "maxLength": 500
                    },
                    "test_name": {
                      "type": "string",
                      "maxLength": 160,
                      "description": "Exact testcase name to bind to criterion, or * for entire report."
                    },
                    "blocked": {
                      "type": "boolean"
                    },
                    "reason": {
                      "type": "string",
                      "maxLength": 240
                    }
                  }
                }
              ]
            }
          },
          "worker_name": {
            "type": "string",
            "maxLength": 128,
            "description": "Optional subagent name for verify_handoff."
          },
          "artifact": {
            "type": "string",
            "maxLength": 500,
            "description": "Relative machine report path for verify_handoff."
          },
          "allow_stale": {
            "type": "boolean",
            "description": "Explicitly bypass source freshness (not recommended)."
          }
        }
      }
    },
    {
      "name": "a2a_evidence",
      "description": "A2A historical evidence, runs, regression hypotheses, incident tracking, side questions, and artifact versioning.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workspace",
          "operation"
        ],
        "properties": {
          "workspace": {
            "type": "string",
            "description": "Absolute path of an authorized workspace (Antigravity IDE workspaces authorized automatically)."
          },
          "operation": {
            "type": "string",
            "enum": [
              "list",
              "runs",
              "incidents",
              "record_incident",
              "add_hypothesis",
              "hypotheses",
              "side_questions",
              "record_side_question",
              "artifact_versions",
              "artifact_diff",
              "snapshot_artifact"
            ]
          },
          "id": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "title": {
            "type": "string",
            "maxLength": 240
          },
          "root_cause": {
            "type": "string",
            "maxLength": 1400
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 500
            },
            "maxItems": 200
          },
          "criteria": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 40
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 20
          },
          "hypothesis": {
            "type": "string",
            "maxLength": 1000
          },
          "experiment": {
            "type": "string",
            "maxLength": 1000
          },
          "incident_id": {
            "type": "string"
          },
          "conversation_id": {
            "type": "string",
            "maxLength": 128
          },
          "parent_conversation_id": {
            "type": "string",
            "maxLength": 128
          },
          "question": {
            "type": "string",
            "maxLength": 4000
          },
          "summary": {
            "type": "string",
            "maxLength": 4000
          },
          "status": {
            "type": "string",
            "maxLength": 40
          },
          "artifact_name": {
            "type": "string",
            "maxLength": 240
          },
          "artifact_path": {
            "type": "string",
            "maxLength": 500
          },
          "version_number": {
            "type": "integer",
            "minimum": 1
          },
          "v1": {
            "type": "integer",
            "minimum": 0
          },
          "v2": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  ]
}
