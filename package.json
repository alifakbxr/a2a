{
  "name": "@aliip/pilah",
  "version": "1.1.1",
  "description": "PILAH (Project Intelligence, Logic, Analysis & Handoffs): native-first engineering context, minimal-change guidance and evidence-scoped verification for Google Antigravity.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "antigravity",
    "google-antigravity",
    "ai-agent",
    "static-analysis",
    "code-graph",
    "impact-analysis",
    "blast-radius",
    "acceptance-testing",
    "verification",
    "developer-tools",
    "cli"
  ],
  "type": "module",
  "main": "src/engine.mjs",
  "bin": {
    "pilah": "scripts/pilah.mjs",
    "a2a": "scripts/a2a.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alifakbxr/pilah.git"
  },
  "bugs": {
    "url": "https://github.com/alifakbxr/pilah/issues"
  },
  "homepage": "https://github.com/alifakbxr/pilah#readme",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "npm run syntax && npm test",
    "selftest": "node scripts/pilah.mjs doctor",
    "benchmark": "node benchmarks/bench.mjs",
    "benchmark:skills": "node benchmarks/skill-routing.mjs",
    "syntax": "node scripts/check-syntax.mjs"
  }
}
